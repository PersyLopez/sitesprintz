# SiteSprintz Production Environment Configuration
# Copy this file to .env.production and fill in all values
# NEVER commit secrets or actual values to version control

# ============================================================================
# CORE APPLICATION
# ============================================================================

# Node environment (must be 'production' for production deployments)
NODE_ENV=production

# Port the server listens on (default: 3000)
PORT=3000

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# JWT signing key (must be a strong random string, 32+ bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-random-jwt-secret-here-32-bytes-minimum

# Admin token for protected endpoints (strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your-strong-admin-token-here

# Encryption key for stored payment processor tokens (32 bytes, base64 or hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/sitesprintz_prod

# ============================================================================
# PAYMENT PROCESSING - STRIPE (LIVE)
# ============================================================================

# Stripe live secret key (must start with sk_live_)
# Find in: Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here

# Stripe publishable key (must start with pk_live_)
# Find in: Stripe Dashboard > Developers > API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here

# Stripe webhook signing secret (must be the live webhook secret)
# Create webhook at: Stripe Dashboard > Developers > Webhooks
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# Stripe price IDs for subscription plans (must be live price IDs)
# Find in: Stripe Dashboard > Products > [Product Name] > Pricing
STRIPE_PRICE_PRO=price_1A2B3C4D5E6F7G8H9I0J1K2L
STRIPE_PRICE_GROWTH=price_2B3C4D5E6F7G8H9I0J1K2L3M

# ============================================================================
# PAYMENT PROCESSING - STRIPE CONNECT (MARKETPLACE)
# ============================================================================

# Stripe Connect credentials for marketplace payment processing
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id_here

# ============================================================================
# PAYMENT PROCESSING - SQUARE
# ============================================================================

# Square application ID and access token (optional, if using Square)
SQUARE_APPLICATION_ID=your_square_app_id_here
SQUARE_ACCESS_TOKEN=your_square_access_token_here

# ============================================================================
# EMAIL SERVICE - RESEND
# ============================================================================

# Resend API key for sending transactional emails
# Find in: Resend Dashboard > API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email address with Resend
# Must be verified in Resend Dashboard
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# AUTHENTICATION - GOOGLE OAUTH
# ============================================================================

# Google OAuth credentials
# Create in: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Google OAuth callback URL (must match authorized URI in Google Cloud Console)
# Format: https://yourdomain.com/auth/google/callback
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

# ============================================================================
# DOMAIN MANAGEMENT
# ============================================================================

# Your production server IP (used for custom domain DNS instructions)
SERVER_IP=203.0.113.1

# Your main application domain
SITE_URL=https://sitesprintz.com
CLIENT_URL=https://app.sitesprintz.com

# ============================================================================
# ANALYTICS & TRACKING (OPTIONAL)
# ============================================================================

# Analytics service credentials (if using external analytics)
# ANALYTICS_KEY=your_analytics_key_here

# ============================================================================
# LOGGING & DEBUGGING (OPTIONAL)
# ============================================================================

# Log level for application logging
# Options: error, warn, info, debug, trace
LOG_LEVEL=info

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================

# Session secret for Express sessions (strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-strong-session-secret-here-32-bytes-minimum

# ============================================================================
# NOTES FOR SETUP
# ============================================================================

# 1. All marked CRITICAL values must be set before launching to production
# 2. Generate all random tokens using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. For Stripe, ensure you are using LIVE keys (sk_live_, pk_live_, whsec_)
# 4. Update Google Cloud Console with the production GOOGLE_CALLBACK_URL
# 5. Create webhook endpoint in Stripe Dashboard and set STRIPE_WEBHOOK_SECRET
# 6. Update SERVER_IP with your actual production server IP
# 7. Verify Resend email sender before sending production emails
# 8. Never commit secrets or .env.production to version control
# 9. Use environment variables or secrets manager for deployment
# 10. Test all integrations in staging before production deployment
