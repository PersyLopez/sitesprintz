{
  "name": "small-biz-template",
  "version": "1.0.0",
  "description": "<p align=\"center\">  <img src=\"https://i.imgur.com/pU5A58S.png\" alt=\"Microsoft Active Directory Logo\"/>  </p>",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pre-deploy": "playwright test tests/e2e/pre-deployment-comprehensive.spec.js",
    "start": "node server.js",
    "dev": "vite",
    "dev:backend": "NODE_ENV=development node server.js",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npx http-server public -p 5173",
    "validate-template": "node validation/validate-template.js",
    "validate-templates": "node validation/validate-template.js public/data/templates/",
    "create-admin": "node scripts/create-admin.js",
    "create-demo-sites": "node scripts/create-demo-sites.js",
    "seed:gallery": "node scripts/seed-gallery-example-sites.js",
    "seed:testers": "node scripts/seed-tester-accounts.js",
    "setup-beta": "./scripts/setup-beta-env.sh",
    "create-beta-sites": "node scripts/create-beta-sites.js",
    "lint": "eslint . --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "build:prod": "prisma generate && vite build",
    "start:prod": "NODE_ENV=production node server.js",
    "launch:check": "node scripts/launch-check.js",
    "predeploy": "npm run build:prod && npm run launch:check",
    "graphify:processes": "bash scripts/graphify-processes.sh",
    "graphify:processes:vault": "bash scripts/graphify-processes.sh --vault",
    "graphify:obsidian": "bash scripts/graphify-processes.sh --vault --hub",
    "graphify:obsidian:open": "bash scripts/graphify-processes.sh --vault --hub --open",
    "graphify:hub": "bash scripts/graphify-processes.sh --hub-only"
  },
