generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model appointments {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String                  @db.Uuid
  service_id            String                  @db.Uuid
  staff_id              String                  @db.Uuid
  start_time            DateTime                @db.Timestamp(6)
  end_time              DateTime                @db.Timestamp(6)
  duration_minutes      Int
  timezone              String                  @db.VarChar(100)
  customer_name         String                  @db.VarChar(255)
  customer_email        String                  @db.VarChar(255)
  customer_phone        String?                 @db.VarChar(50)
  customer_notes        String?
  confirmation_code     String                  @unique @db.VarChar(50)
  booking_source        String?                 @default("online") @db.VarChar(50)
  status                String?                 @default("confirmed") @db.VarChar(20)
  requires_approval     Boolean?                @default(false)
  cancelled_at          DateTime?               @db.Timestamp(6)
  cancellation_reason   String?
  cancelled_by          String?                 @db.VarChar(50)
  total_price_cents     Int                     @default(0)
  internal_notes        String?
  
  payment_status        String?                 @default("unpaid") @db.VarChar(20)
  payment_method        String?                 @db.VarChar(20)
  payment_intent_id     String?                 @unique @db.VarChar(255)
  payment_amount_cents  Int?                    @default(0)
  deposit_paid_cents    Int?                    @default(0)
  remaining_balance_cents Int?                  @default(0)
  stripe_session_id     String?                 @db.VarChar(255)
  stripe_charge_id      String?                 @db.VarChar(255)
  payment_initiated_at  DateTime?               @db.Timestamp(6)
  paid_at               DateTime?               @db.Timestamp(6)
  refunded_at           DateTime?               @db.Timestamp(6)
  refund_amount_cents   Int?                    @default(0)
  refund_reason         String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  booking_services      booking_services        @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking_staff         booking_staff           @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking_tenants       booking_tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  booking_notifications booking_notifications[]

  @@index([confirmation_code], map: "idx_appointments_confirmation")
  @@index([customer_email], map: "idx_appointments_customer_email")
  @@index([start_time, end_time], map: "idx_appointments_date_range")
  @@index([service_id], map: "idx_appointments_service")
  @@index([staff_id], map: "idx_appointments_staff")
  @@index([start_time], map: "idx_appointments_start_time")
  @@index([status], map: "idx_appointments_status")
  @@index([tenant_id], map: "idx_appointments_tenant")
  @@index([confirmation_code], map: "idx_appointments_code")
  @@index([staff_id, start_time], map: "idx_appointments_staff_time")
  @@index([payment_status], map: "idx_appointments_payment_status")
  @@index([payment_intent_id], map: "idx_appointments_payment_intent")
  @@index([stripe_session_id], map: "idx_appointments_stripe_session")
  @@index([paid_at], map: "idx_appointments_paid_at")
}



model booking_availability_rules {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String          @db.Uuid
  staff_id        String          @db.Uuid
  day_of_week     Int
  start_time      DateTime        @db.Time(6)
  end_time        DateTime        @db.Time(6)
  is_available    Boolean?        @default(true)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  updated_at      DateTime?       @default(now()) @db.Timestamp(6)
  booking_staff   booking_staff   @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  booking_tenants booking_tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([day_of_week], map: "idx_availability_day")
  @@index([staff_id], map: "idx_availability_staff")
  @@index([tenant_id], map: "idx_availability_tenant")
  @@index([staff_id], map: "idx_booking_availability_staff")
}


model booking_notifications {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String          @db.Uuid
  appointment_id      String?         @db.Uuid
  type                String          @db.VarChar(50)
  channel             String          @default("email") @db.VarChar(20)
  recipient_email     String?         @db.VarChar(255)
  recipient_phone     String?         @db.VarChar(50)
  subject             String?         @db.VarChar(500)
  message             String?
  status              String?         @default("pending") @db.VarChar(20)
  sent_at             DateTime?       @db.Timestamp(6)
  error_message       String?
  provider            String?         @db.VarChar(50)
  provider_message_id String?         @db.VarChar(255)
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  appointments        appointments?   @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  booking_tenants     booking_tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([appointment_id], map: "idx_notifications_appointment")
  @@index([status], map: "idx_notifications_status")
  @@index([tenant_id], map: "idx_notifications_tenant")
}


model booking_services {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String          @db.Uuid
  name                   String          @db.VarChar(255)
  description            String?
  category               String?         @db.VarChar(100)
  duration_minutes       Int
  price_cents            Int             @default(0)
  online_booking_enabled Boolean?        @default(true)
  requires_approval      Boolean?        @default(false)
  display_order          Int?            @default(0)
  status                 String?         @default("active") @db.VarChar(20)
  
  buffer_minutes_before  Int?            @default(0)
  buffer_minutes_after   Int?            @default(0)
  
  requires_payment       Boolean?        @default(false)
  payment_type           String?         @default("none") @db.VarChar(20)
  deposit_percentage     Int?            @default(50)
  cancellation_policy    String?
  refund_policy          String?         @default("full") @db.VarChar(50)
  created_at             DateTime?       @default(now()) @db.Timestamp(6)
  updated_at             DateTime?       @default(now()) @db.Timestamp(6)
  appointments           appointments[]
  booking_tenants        booking_tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_staff          service_staff[]

  @@index([category], map: "idx_booking_services_category")
  @@index([status], map: "idx_booking_services_status")
  @@index([tenant_id], map: "idx_booking_services_tenant")
  @@index([requires_payment], map: "idx_booking_services_requires_payment")
}


model booking_staff {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String                       @db.Uuid
  name                       String                       @db.VarChar(255)
  email                      String?                      @db.VarChar(255)
  phone                      String?                      @db.VarChar(50)
  title                      String?                      @db.VarChar(255)
  bio                        String?
  avatar_url                 String?
  photo_url                  String?
  specialties                String?
  buffer_time_after          Int?                         @default(0)
  max_advance_booking_days   Int?                         @default(90)
  min_advance_booking_hours  Int?                         @default(2)
  display_order              Int?                         @default(0)
  is_primary                 Boolean?                     @default(false)
  is_default                 Boolean?                     @default(false)
  status                     String?                      @default("active") @db.VarChar(20)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  appointments               appointments[]
  booking_availability_rules booking_availability_rules[]
  booking_tenants            booking_tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_users                staff_users[]
  service_staff              service_staff[]

  @@index([status], map: "idx_booking_staff_status")
  @@index([tenant_id], map: "idx_booking_staff_tenant")
}


model booking_tenants {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id                    String?                      @db.VarChar(255)
  business_name              String                       @db.VarChar(255)
  business_type              String?                      @db.VarChar(100)
  phone                      String?                      @db.VarChar(50)
  email                      String?                      @db.VarChar(255)
  timezone                   String?                      @default("America/New_York") @db.VarChar(100)
  currency                   String?                      @default("USD") @db.VarChar(3)
  booking_page_enabled       Boolean?                     @default(true)
  confirmation_email_enabled Boolean?                     @default(true)
  reminder_email_enabled     Boolean?                     @default(true)
  status                     String?                      @default("active") @db.VarChar(20)
  
  business_mode              String?                      @default("solo") @db.VarChar(20)
  staff_selection_enabled    Boolean?                     @default(false)
  allow_no_preference        Boolean?                     @default(true)
  no_preference_text         String?                      @default("Any Available") @db.VarChar(100)
  
  reminder_hours_before      Int?                         @default(24)
  
  stripe_account_id          String?                      @db.VarChar(255)
  payment_enabled            Boolean?                     @default(false)
  default_payment_type       String?                      @default("none") @db.VarChar(20)
  default_deposit_percentage Int?                         @default(50)
  cancellation_window_hours  Int?                         @default(24)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  user_id                    String?                      @db.Uuid
  appointments               appointments[]
  booking_availability_rules booking_availability_rules[]
  booking_notifications      booking_notifications[]
  booking_services           booking_services[]
  booking_staff              booking_staff[]
  service_staff              service_staff[]
  sites                      sites?                       @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                      users?                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([site_id], map: "idx_booking_tenants_site")
  @@index([stripe_account_id], map: "idx_booking_tenants_stripe_account")
  @@index([payment_enabled], map: "idx_booking_tenants_payment_enabled")
  @@index([business_mode], map: "idx_booking_tenants_business_mode")
}

model pricing {
  id         Int       @id @default(autoincrement())
  tier       String    @unique @db.VarChar(50)
  price      Decimal   @db.Decimal(10, 2)
  features   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}



model plan_features {
  id         Int       @id @default(autoincrement())
  plan       String    @db.VarChar(50)  
  feature    String    @db.VarChar(100)
  enabled    Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([plan, feature], map: "idx_plan_features_unique")
  @@index([plan], map: "idx_plan_features_plan")
}

model drafts {
  id                  String    @id @db.VarChar(255)
  user_id             String?   @db.Uuid
  template_id         String?   @db.VarChar(255)
  business_data       Json?
  site_data           Json?
  status              String?   @default("draft") @db.VarChar(50)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @updatedAt @db.Timestamp(6)
  expires_at          DateTime? @db.Timestamp(6)
  published_site_id   String?   @db.VarChar(255)
  published_at        DateTime? @db.Timestamp(6)
  users               users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}


model sites {
  id              String            @id @db.VarChar(255)
  subdomain       String            @unique @db.VarChar(255)
  template_id     String?           @db.VarChar(255)
  status          String?           @default("draft") @db.VarChar(50)
  plan            String?           @default("free") @db.VarChar(50)
  published_at    DateTime?         @db.Timestamp(6)
  expires_at      DateTime?         @db.Timestamp(6)
  site_data       Json?
  json_file_path  String?           @db.VarChar(255)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  is_public              Boolean           @default(false)
  is_featured            Boolean?          @default(false)
  view_count             Int?              @default(0)
  user_id                String?           @db.Uuid
  custom_domain          String?           @unique @db.VarChar(255)
  custom_domain_status   String?           @default("pending") @db.VarChar(50)
  custom_domain_verified DateTime?
  
  payment_processor      String?           @default("stripe") @db.VarChar(50)
  booking_tenants        booking_tenants[]
  users                  users?            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submissions            submissions[]
  payment_processor_credentials payment_processor_credentials[]
  payment_method         site_payment_method?
  analytics_page_views    analytics_page_views[]
  analytics_orders        analytics_orders[]
  analytics_conversions   analytics_conversions[]
}

model submissions {
  id         Int       @id @default(autoincrement())
  site_id    String?   @db.VarChar(255)
  form_type  String?   @db.VarChar(100)
  data       Json?
  status     String?   @default("unread") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  sites      sites?    @relation(fields: [site_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  email                    String            @unique @db.VarChar(255)
  password_hash            String            @db.VarChar(255)
  role                     String?           @default("user") @db.VarChar(50)
  status                   String?           @default("pending") @db.VarChar(50) 
  subscription_status      String?           @db.VarChar(50)
  subscription_plan        String?           @db.VarChar(50)
  created_at               DateTime?         @default(now()) @db.Timestamp(6)
  last_login               DateTime?         @db.Timestamp(6)
  google_id                String?           @unique @db.VarChar(255)
  picture                  String?
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  email_verified           Boolean?          @default(false)
  verification_token        String?           @unique @db.VarChar(255)
  verification_token_expires DateTime?        @db.Timestamp(6)
  verified_at               DateTime?        @db.Timestamp(6)
  
  password_reset_token     String?           @unique @db.VarChar(255)
  password_reset_expires   DateTime?         @db.Timestamp(6)
  password_changed_at      DateTime?         @db.Timestamp(6)
  
  stripe_customer_id       String?           @unique @db.VarChar(255)
  stripe_account_id        String?           @unique @db.VarChar(255)
  stripe_connected         Boolean?          @default(false)
  stripe_subscription_id   String?           @db.VarChar(255)
  current_period_end       DateTime?         @db.Timestamp(6)
  
  plan                     String?           @db.VarChar(50)
  booking_tenants          booking_tenants[]
  sites                    sites[]
  drafts                   drafts[]
  refresh_tokens        refresh_tokens[]
  staff_users              staff_users[]

  @@index([google_id], map: "idx_users_google_id")
  @@index([verification_token], map: "idx_users_verification_token")
  @@index([email_verified], map: "idx_users_email_verified")
  @@index([password_reset_token], map: "idx_users_password_reset_token")
  @@index([stripe_customer_id], map: "idx_users_stripe_customer_id")
  @@index([stripe_account_id], map: "idx_users_stripe_account_id")
}

model refresh_tokens {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  token           String   @unique @db.VarChar(255)
  expires_at      DateTime @db.Timestamp(6)
  revoked         Boolean  @default(false)
  revoked_at      DateTime? @db.Timestamp(6)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  last_used_at    DateTime? @db.Timestamp(6)
  
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([token], map: "idx_refresh_tokens_token")
  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
}

model menu_items {
  id            Int       @id @default(autoincrement())
  subdomain     String    @db.VarChar(255)
  name          String    @db.VarChar(255)
  description   String?
  price         Decimal   @db.Decimal(10, 2)
  category      String?   @default("Uncategorized") @db.VarChar(100)
  image         String?
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([subdomain], map: "idx_menu_items_subdomain")
}

model services {
  id              Int               @id @default(autoincrement())
  subdomain       String            @db.VarChar(255)
  name            String            @db.VarChar(255)
  description     String?
  duration        Int?
  price           Decimal?          @db.Decimal(10, 2)
  category        String?           @default("Services") @db.VarChar(100)
  display_order   Int?              @default(0)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  service_pricing service_pricing[]

  @@index([subdomain], map: "idx_services_subdomain")
}

model service_pricing {
  id          Int       @id @default(autoincrement())
  service_id  Int
  tier        String    @db.VarChar(50)
  price       Decimal   @db.Decimal(10, 2)
  duration    Int?
  description String?
  services    services  @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([service_id], map: "idx_service_pricing_service")
}

model products {
  id            Int       @id @default(autoincrement())
  subdomain     String    @db.VarChar(255)
  name          String    @db.VarChar(255)
  description   String?
  price         Decimal   @db.Decimal(10, 2)
  inventory     Int       @default(0)
  images        Json?
  variants      Json?
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  order_items   order_items[]

  @@index([subdomain], map: "idx_products_subdomain")
}



model orders {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id              String        @db.VarChar(255)
  user_id              String?       @db.Uuid
  customer_email       String        @db.VarChar(255)
  customer_name        String?       @db.VarChar(255)
  customer_phone       String?       @db.VarChar(50)
  
  
  items                Json          @default("[]")
  total_amount         Decimal       @db.Decimal(10, 2)
  currency             String        @default("usd") @db.VarChar(3)
  
  
  stripe_session_id    String?       @unique @db.VarChar(255)
  stripe_payment_id    String?       @db.VarChar(255)
  stripe_charge_id     String?       @db.VarChar(255)
  payment_status       String?       @default("unpaid") @db.VarChar(20)
  
  
  status               String?       @default("pending") @db.VarChar(50)
  
  
  fulfillment_type     String?       @db.VarChar(50)
  scheduled_for        DateTime?     @db.Timestamp(6)
  shipping_address     Json?
  special_instructions String?
  notes                String?
  
  
  metadata             Json?
  created_at           DateTime?     @default(now()) @db.Timestamp(6)
  updated_at           DateTime?     @default(now()) @db.Timestamp(6)
  completed_at         DateTime?     @db.Timestamp(6)
  
  order_items          order_items[]
  
  @@index([site_id], map: "idx_orders_site_id")
  @@index([customer_email], map: "idx_orders_customer_email")
  @@index([status], map: "idx_orders_status")
  @@index([payment_status], map: "idx_orders_payment_status")
  @@index([stripe_session_id], map: "idx_orders_stripe_session_id")
  @@index([stripe_payment_id], map: "idx_orders_stripe_payment_id")
  @@index([created_at], map: "idx_orders_created_at")
  @@index([user_id], map: "idx_orders_user_id")
}


model order_items {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String   @db.Uuid
  product_id    Int?
  
  
  name          String   @db.VarChar(255)
  description   String?
  quantity      Int
  unit_price    Decimal  @db.Decimal(10, 2)
  total_price   Decimal  @db.Decimal(10, 2)
  
  
  modifiers     Json?    @default("[]")
  
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  
  orders        orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products      products? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  
  @@index([order_id], map: "idx_order_items_order_id")
  @@index([product_id], map: "idx_order_items_product_id")
}



model inventory_transactions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        Int
  order_id          String?   @db.Uuid
  
  
  quantity_change   Int       
  previous_quantity Int
  new_quantity      Int
  transaction_type  String    @db.VarChar(50)  
  
  
  notes             String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  
  @@index([product_id], map: "idx_inventory_transactions_product_id")
  @@index([created_at], map: "idx_inventory_transactions_created_at")
}


model staff_users {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String        @db.Uuid
  staff_id      String        @db.Uuid
  tenant_id     String        @db.Uuid
  role          String        @default("staff") @db.VarChar(50) 
  permissions   Json?         
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  booking_staff booking_staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, tenant_id])
  @@index([staff_id])
  @@index([tenant_id])
}


model staff_invitations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  staff_id      String    @db.Uuid
  email         String    @db.VarChar(255)
  token         String    @unique @db.VarChar(255)
  role          String    @default("staff") @db.VarChar(50)
  permissions   Json?
  status        String    @default("pending") @db.VarChar(50) 
  invited_by    String    @db.Uuid
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  
  @@index([token])
  @@index([email])
  @@index([tenant_id])
}


model tracking_tokens {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String    @db.VarChar(50) 
  reference_id    String    @db.VarChar(255) 
  email           String    @db.VarChar(255)
  token           String    @unique @db.VarChar(255)
  expires_at      DateTime
  last_accessed   DateTime?
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  
  @@index([token])
  @@index([reference_id])
}


model payment_processor_credentials {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id                  String    @db.VarChar(255)
  processor                String    @db.VarChar(50) 
  account_id               String?   @db.VarChar(255)
  
  access_token_encrypted   String?   @db.Text
  refresh_token_encrypted  String?   @db.Text
  webhook_secret_encrypted String?   @db.Text
  
  connected_at             DateTime? @db.Timestamp(6)
  disconnected_at          DateTime? @db.Timestamp(6)
  last_used_at             DateTime? @db.Timestamp(6)
  expires_at               DateTime? @db.Timestamp(6)
  
  is_active                Boolean   @default(true)
  metadata                 Json?
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  updated_at               DateTime? @default(now()) @db.Timestamp(6)
  
  sites                    sites     @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@unique([site_id, processor])
  @@index([site_id])
  @@index([processor])
  @@index([is_active])
}

model site_payment_method {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id           String    @unique @db.VarChar(255)
  
  provider          String    @db.VarChar(50)  // 'stripe', 'square', 'paypal', 'shopify'
  account_id        String    @db.VarChar(255) // Provider-specific ID
  
  is_active         Boolean   @default(true)
  configured_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  
  sites             sites     @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@index([site_id])
  @@index([provider])
}



model webhook_events {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String    @db.VarChar(255) 
  processor     String    @db.VarChar(50)  
  event_type    String    @db.VarChar(100) 
  payload       Json      
  status        String    @db.VarChar(20)  
  processed_at  DateTime  @default(now()) @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  
  @@unique([event_id, processor], map: "event_id_processor")
  @@index([event_id], map: "idx_webhook_events_event_id")
  @@index([processor], map: "idx_webhook_events_processor")
  @@index([processed_at], map: "idx_webhook_events_processed_at")
  @@index([status], map: "idx_webhook_events_status")
}




model service_staff {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id      String           @db.Uuid
  staff_id        String           @db.Uuid
  tenant_id       String           @db.Uuid
  is_primary      Boolean?         @default(false)
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  
  booking_services booking_services @relation(fields: [service_id], references: [id], onDelete: Cascade)
  booking_staff    booking_staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  booking_tenants  booking_tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  
  @@unique([service_id, staff_id])
  @@index([service_id], map: "idx_service_staff_service")
  @@index([staff_id], map: "idx_service_staff_staff")
  @@index([tenant_id], map: "idx_service_staff_tenant")
}

model analytics_page_views {
  id              BigInt    @id @default(autoincrement())
  site_id         String    @db.VarChar(255)
  path            String    @db.VarChar(2048)
  referrer        String?   @db.VarChar(2048)
  user_agent      String?   @db.VarChar(1024)
  ip_address      String?   @db.VarChar(45)
  timestamp       DateTime  @default(now())
  
  sites           sites?    @relation(fields: [site_id], references: [id], onDelete: Cascade)
  
  @@index([site_id])
  @@index([timestamp])
}

model analytics_orders {
  id              BigInt    @id @default(autoincrement())
  site_id         String    @db.VarChar(255)
  order_id        String    @db.VarChar(255)
  value           Int
  timestamp       DateTime  @default(now())
  
  sites           sites?    @relation(fields: [site_id], references: [id], onDelete: Cascade)
  
  @@index([site_id])
  @@index([timestamp])
}

model analytics_conversions {
  id              BigInt    @id @default(autoincrement())
  site_id         String    @db.VarChar(255)
  event_type      String    @db.VarChar(100)
  metadata        Json?
  timestamp       DateTime  @default(now())
  
  sites           sites?    @relation(fields: [site_id], references: [id], onDelete: Cascade)
  
  @@index([site_id])
  @@index([event_type])
}


model templates {
  id            String    @id @default(uuid()) @db.VarChar(36)
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(255)
  industry      String?   @db.VarChar(100)
  description   String?   @db.Text
  layout_key    String?   @db.VarChar(50)
  character     String?   @db.VarChar(50) @default("refined")
  sections      Json
  metadata      Json?
  status        String    @default("active") @db.VarChar(20)
  version       Int       @default(1)
  is_default    Boolean   @default(false)
  created_by    String?   @db.VarChar(36)
  updated_by    String?   @db.VarChar(36)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([status])
  @@index([industry])
  @@index([slug])
}
