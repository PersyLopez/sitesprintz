# SiteSprintz Environment Configuration
# Copy to .env and fill in values. Never commit .env or real secrets.

# =============================================================================
# Core Application
# =============================================================================
NODE_ENV=development
PORT=3000
# Closed beta: set BETA_MODE=true on Railway (NODE_ENV stays production)
BETA_MODE=false
# LLC-bridge: pause platform SaaS/labor/claim checkout until bank is ready (do not set true on Railway yet)
# PLATFORM_COLLECT_PAYMENTS=false
BETA_ALLOW_SIGNUPS=true
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:3000
# Canonical CORS allowlist (required in production). Comma-separated origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Legacy alias still accepted by payment origin checks; prefer CORS_ORIGINS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Database (Required)
# =============================================================================
# PostgreSQL connection string (Neon, local, or Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/sitesprintz

# =============================================================================
# Security (Required)
# =============================================================================
# Generate: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
# AES-256-GCM key (32 bytes = 64 hex chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Admin portal token (development default shown in server logs)
ADMIN_TOKEN=dev-token

# =============================================================================
# OAuth (Optional — required for Google login)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_PLACES_API_KEY=
# Cloud Translation (optional). Drafts Spanish shop copy at publish into site_data.locales.es.
# Without this key, live EN|ES chrome still works; body copy stays English.
GOOGLE_TRANSLATE_API_KEY=

# Redis for OAuth state (optional in dev; required for production OAuth)
REDIS_URL=redis://localhost:6379

# =============================================================================
# Stripe (Required for payments, checkout, subscriptions)
# =============================================================================
# https://dashboard.stripe.com/apikeys — use test keys in development
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PRICE_STARTER=price_YOUR_STARTER_PRICE_ID
STRIPE_PRICE_GROWTH=price_YOUR_GROWTH_PRICE_ID
STRIPE_PRICE_GROWTH_MANAGED=price_YOUR_GROWTH_MANAGED_PRICE_ID
# Optional labor (create with: node scripts/create-labor-stripe-prices.js)
# Customer extras Checkout requires these Price IDs. claim_setup is internal only.
# STRIPE_PRICE_CLAIM_SETUP=price_YOUR_SETUP_PRICE_ID
# STRIPE_PRICE_MANAGED_CARE is unused for customer checkout (care is the $75 Growth Managed plan)
# STRIPE_PRICE_MANAGED_EDIT=price_YOUR_EXTRA_BATCH_PRICE_ID
# STRIPE_PRICE_BRAND_MATCH=price_YOUR_BRAND_MATCH_PRICE_ID
# STRIPE_PRICE_UNIQUE_LOOK=price_YOUR_UNIQUE_LOOK_PRICE_ID
STRIPE_AUTOMATIC_TAX=false
# Optional. Lets site owners connect an existing Stripe account (Standard OAuth).
# Stripe hosts KYC; SiteSprintz never collects bank details.
STRIPE_CLIENT_ID=ca_YOUR_CONNECT_CLIENT_ID

# =============================================================================
# Email (At least one provider recommended)
# =============================================================================
# Resend (preferred)
RESEND_API_KEY=

# SMTP fallback (Outlook, Gmail, etc.)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=SiteSprintz
ADMIN_EMAIL=
# External uptime monitor (Better Stack or UptimeRobot — dashboard or API)
# URL: https://sitesprintz.com/api/health
# Expect: HTTP 200 and JSON with "status":"ok" (or "degraded" if DB is down)
# Interval: 5 minutes or less (Railway healthcheckPath already covers restarts)
# Tokens below are for monitor API/CLI setup only — the app does not read them
BETTERSTACK_API_TOKEN=
UPTIMEROBOT_API_KEY=
HEALTH_PROBE_SECRET=
HEALTH_PROBE_SUBDOMAIN=

# Legacy aliases (some routes still reference these)
EMAIL_USER=
EMAIL_PASS=

# =============================================================================
# CAPTCHA (Optional — Cloudflare Turnstile)
# =============================================================================
# Production only. Leave both unset locally so agents can use /login testers.
# Frontend reads VITE_TURNSTILE_SITE_KEY (rebuild after changing it).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# Optional Payment Providers
# =============================================================================
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URL=
SQUARE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_REDIRECT_URL=

# =============================================================================
# Infrastructure (Production)
# =============================================================================
SERVER_IP=
CACHE_TTL_SECONDS=300

# =============================================================================
# Development & Testing
# =============================================================================
EXPOSE_ERROR_DETAILS=false
PLAYWRIGHT_BASE_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Sandbox keys for integration tests (optional)
STRIPE_TEST_KEY=
SQUARE_SANDBOX_TOKEN=
SQUARE_SANDBOX_LOCATION=
PAYPAL_SANDBOX_CLIENT=
PAYPAL_SANDBOX_SECRET=
